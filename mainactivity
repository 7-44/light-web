package com.example.myweb

import android.app.Activity
import android.app.DownloadManager
import android.content.Context
import android.net.Uri
import android.os.Bundle
import android.os.Environment
import android.view.Gravity
import android.view.View
import android.view.ViewGroup
import android.view.inputmethod.EditorInfo
import android.webkit.*
import android.widget.*

class MainActivity : Activity() {
    private lateinit var webView: WebView
    private lateinit var progressBar: ProgressBar

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // 메인 레이아웃
        val root = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
        
        // 주소창 영역
        val toolbar = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
        val addr = EditText(this).apply { 
            layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
            inputType = 1; hint = "URL" 
        }
        val btnGo = Button(this).apply { text = "go" }
        toolbar.addView(addr); toolbar.addView(btnGo)

        // 웹뷰 컨테이너
        val container = FrameLayout(this)
        webView = WebView(this).apply {
            setLayerType(View.LAYER_TYPE_HARDWARE, null)
            settings.apply {
                javaScriptEnabled = true
                domStorageEnabled = true
                userAgentString = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
            }
            webViewClient = object : WebViewClient() {
                override fun onPageStarted(v: WebView?, u: String?, b: android.graphics.Bitmap?) { progressBar.visibility = View.VISIBLE }
                override fun onPageFinished(v: WebView?, u: String?) { progressBar.visibility = View.GONE }
            }
            setDownloadListener { url, ua, disp, mime, _ ->
                val req = DownloadManager.Request(Uri.parse(url)).apply {
                    setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
                    setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, URLUtil.guessFileName(url, disp, mime))
                }
                (getSystemService(Context.DOWNLOAD_SERVICE) as DownloadManager).enqueue(req)
                Toast.makeText(this@MainActivity, "다운로드 시작", Toast.LENGTH_SHORT).show()
            }
        }

        // 정적인 로딩바 (애니메이션 최소화)
        progressBar = ProgressBar(this, null, android.R.attr.progressBarStyleSmall).apply {
            layoutParams = FrameLayout.LayoutParams(100, 100, Gravity.CENTER)
            visibility = View.GONE
        }
        
        container.addView(webView); container.addView(progressBar)
        root.addView(toolbar); root.addView(container)
        setContentView(root)

        // 버튼 및 키보드 액션
        btnGo.setOnClickListener { 
            val url = if (addr.text.startsWith("http")) addr.text.toString() else "https://${addr.text}"
            webView.loadUrl(url) 
        }
        addr.setOnEditorActionListener { _, actionId, _ -> if (actionId == EditorInfo.IME_ACTION_GO) btnGo.performClick(); true }
        
        webView.loadUrl("https://www.google.com")
    }

    override fun onBackPressed() { if (webView.canGoBack()) webView.goBack() else super.onBackPressed() }
}

